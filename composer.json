{
    "name": "phpaml/framework",
    "description": "PHPAML MVC framework core",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": ">=8.2",
        "ext-fileinfo": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "PHPAML\\": "src/"
        }
    },
    "scripts": {
        "test": "php tests/run.php",
        "analyse": "phpstan analyse src --level=6"
    }
}
